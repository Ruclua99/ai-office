# Cổng & địa chỉ (chỉ nghe trên máy bạn — đừng đổi HOST thành 0.0.0.0 nếu không hiểu rủi ro)
PORT=4800
HOST=127.0.0.1

# Token bảo vệ API localhost. Bỏ trống = tự sinh mỗi lần chạy
OFFICE_TOKEN=

# Số nhân viên làm việc cùng lúc (người đang chờ duyệt quyền không tính). Càng cao càng tốn token nhanh.
MAX_CONCURRENT=6
# Xin quyền quá bấy nhiêu phút không ai duyệt → tự từ chối, nhân viên làm tiếp phần khác (0 = chờ mãi)
PERMISSION_TIMEOUT_MIN=30
# Mỗi nhân viên giữ bao nhiêu dòng nhật ký gần nhất (cũ hơn tự xoá)
KEEP_EVENTS_PER_AGENT=2000
# Tối đa bao nhiêu cấp "giao việc lồng nhau" (A giao B, B giao C…) — chặn vòng lặp
MAX_DELEGATION_DEPTH=3
MAX_QUEUE_PER_AGENT=10

# --- Nhân viên "anthropic-chat"
ANTHROPIC_API_KEY=
DEFAULT_ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Nhân viên "openai-chat"
OPENAI_API_KEY=
DEFAULT_OPENAI_MODEL=gpt-5

# --- Nhân viên "claude-code": dùng đăng nhập của Claude Code CLI trên máy (claude login),
#     hoặc ANTHROPIC_API_KEY ở trên.
# --- Nhân viên "codex": dùng `codex login`, hoặc:
# CODEX_API_KEY=

# Đường dẫn transcript nếu bạn để khác mặc định
# CLAUDE_PROJECTS_DIR=C:\Users\linh\.claude\projects
# CODEX_SESSIONS_DIR=C:\Users\linh\.codex\sessions
